{
  "name": "hw04-eshop-automation",
  "version": "1.0.0",
  "private": true,
  "description": "HW04 - Automation Testing on EShop SUT (FR-06, FR-09, FR-15) - Student 23127362",
  "type": "module",
  "scripts": {
    "postinstall": "playwright install",
    "typecheck": "tsc --noEmit",

    "smoke": "node scripts/run-matrix.mjs --feature smoke --browser chromium",
    "smoke:all": "node scripts/run-matrix.mjs --feature smoke",

    "test:matrix": "node scripts/run-matrix.mjs",
    "test:fr06": "node scripts/run-matrix.mjs --feature fr06",
    "test:fr09": "node scripts/run-matrix.mjs --feature fr09",
    "test:fr15": "node scripts/run-matrix.mjs --feature fr15",
    "test:chromium": "node scripts/run-matrix.mjs --browser chromium",
    "test:firefox": "node scripts/run-matrix.mjs --browser firefox",
    "test:webkit": "node scripts/run-matrix.mjs --browser webkit",

    "stamp:all": "node scripts/stamp-report.mjs --all",
    "verify:reports": "node scripts/verify-reports.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.10.0",
    "csv-parse": "^5.6.0",
    "typescript": "^5.7.0"
  }
}
